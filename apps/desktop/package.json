{
  "name": "@igup/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -R src/renderer dist/renderer && cp -R src/preload dist/preload",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
